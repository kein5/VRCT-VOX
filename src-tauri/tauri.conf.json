{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCT-VOX",
    "version": "0.1.0",
    "identifier": "io.github.kein5.vrct-vox",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": false,
        "windows": [
            {
                "title": "VRCT-VOX",
                "center": true,
                "width": 450,
                "height": 220,
                "minWidth": 400,
                "minHeight": 200,
                "transparent": true,
                "decorations": false,
                "shadow": false,
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                "default",
                "quick-chat",
                "vrct-capability"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "publisher": "kein5",
        "copyright": "Copyright m's software",
        "licenseFile": "../LICENSE",
        "shortDescription": "VRCT-VOX — speech, voice conversion and translated chat",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "bin/vrct-vox-sidecar"
        ],
        "resources": {
            "bin/_internal": "_internal"
        },
        "windows": {
            "nsis": {
                "template": "nsis/template.nsi",
                "installMode": "currentUser",
                "displayLanguageSelector": true,
                "languages": [
                    "English",
                    "Japanese",
                    "Korean",
                    "TradChinese",
                    "SimpChinese"
                ]
            }
        }
    },
    "mainBinaryName": "vrct-vox"
}
