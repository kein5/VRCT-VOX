{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCT-VOX",
    "version": "0.2.0",
    "identifier": "io.github.kein5.vrct-vox",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": false,
        "windows": [
            {
                "title": "VRCT-VOX",
                "center": true,
                "width": 450,
                "height": 220,
                "minWidth": 400,
                "minHeight": 200,
                "transparent": true,
                "decorations": false,
                "shadow": false,
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": [
                    "'self'",
                    "'sha256-I2px+fnpbN4E5+Djrj7aoTIyq9yyREkuVl19f4Sye9A='",
                    "'sha256-Xo8/tnRnpUxMw05nUf764oT49W2GEbQN9LaX8Wqxuwg='"
                ],
                "style-src-attr": "'none'",
                "img-src": "'self' data:",
                "font-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
                "media-src": "'none'",
                "worker-src": "'none'",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-ancestors": "'none'",
                "form-action": "'none'"
            },
            "capabilities": [
                "default",
                "quick-chat",
                "caption-overlay",
                "vrct-capability"
            ],
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline'",
                "style-src": "'self' 'unsafe-inline'",
                "style-src-attr": "'none'",
                "img-src": "'self' data:",
                "font-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
                "media-src": "'none'",
                "worker-src": "'none'",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-ancestors": "'none'",
                "form-action": "'none'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "publisher": "kein5",
        "copyright": "Copyright m's software",
        "licenseFile": "../LICENSE",
        "shortDescription": "VRCT-VOX — speech, voice conversion and translated chat",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "bin/vrct-vox-sidecar"
        ],
        "resources": {
            "bin/_internal": "_internal"
        },
        "windows": {
            "nsis": {
                "template": "nsis/template.nsi",
                "installMode": "currentUser",
                "displayLanguageSelector": true,
                "languages": [
                    "English",
                    "Japanese"
                ]
            }
        }
    },
    "mainBinaryName": "vrct-vox"
}
