# Follow .gitattributes (LF on all platforms). Applies to future edits only.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,html,css,scss}]
indent_size = 2

[*.md]
# Two trailing spaces may be a Markdown hard line break.
trim_trailing_whitespace = false

[*.{patch,diff}]
# Unified-diff context and final-newline markers are significant.
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset

[{Makefile,*.mk}]
indent_style = tab
indent_size = unset
